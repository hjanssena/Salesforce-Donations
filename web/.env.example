# Copy to .env.local for `npm run dev`. Never commit .env.local.
# mock answers from the contract examples in the browser; salesforce calls SF_SITE_URL.
VITE_API_MODE=mock
# Public Salesforce Site URL (no trailing slash). Needed only with salesforce.
VITE_SF_SITE_URL=https://example.my.salesforce-sites.com/donations
# Stripe TEST publishable key. Never a pk_live_ or sk_ key (M1, M3).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
